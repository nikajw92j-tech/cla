# Database — PostgreSQL (Neon / Supabase / Vercel Postgres). For local dev you can run
# `npx prisma dev` and paste its TCP URL here (add &pgbouncer=true&connection_limit=1).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me"

# Public base URL (used in emails, OG metadata, referral links)
APP_URL="http://localhost:3000"

# SMTP (optional). If unset, emails are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Nexora Studio <hello@example.com>"

# Seed admin account
ADMIN_EMAIL="nikajw92j@gmail.com"
ADMIN_PASSWORD="Admin12345!"
